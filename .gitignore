# Terraform working directories
**/.terraform/

# Terraform state
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Variable files can contain environment-specific or sensitive values
*.tfvars
*.tfvars.json
!*.tfvars.example

# Saved plans can contain sensitive values
*.tfplan
tfplan
planout

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Operating system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Keep .terraform.lock.hcl in version control for reproducible provider selection
